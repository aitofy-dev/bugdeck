# bugdeck server — copy to .env and fill in.
# Everything is read once at startup; a missing required value exits 1 naming it.

# ─── tracker ─────────────────────────────────────────────────────
# The only adapter in this release.
TRACKER=plane

# Required. The Plane instance, the workspace slug from its URL, and the
# project reports are filed into.
PLANE_BASE_URL=https://plane.example.com
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxx
PLANE_WORKSPACE_SLUG=acme
PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional. Projects the poller also READS — nothing is ever written to them.
# Comma separated. Use it when the board moved and old reports stayed behind.
# PLANE_LEGACY_PROJECT_IDS=

# Optional. Columns are discovered from the board by group; set this only when
# yours does not follow the convention. JSON, state → Plane state id.
# PLANE_STATE_MAP={"pending":"...","doing":"...","review":"...","done":"...","fail":"..."}

# ─── this server ─────────────────────────────────────────────────
# Where reports.db and assets/ live. Mount a volume at it in Docker.
STORAGE_PATH=./storage
PORT=3131

# How the outside world reaches this server. Used for the asset links the
# tracker gets when it refuses an upload.
PUBLIC_URL=https://bugs.example.com

# `header` trusts X-User-Id / X-User-Email. ONLY safe behind your own
# authenticating proxy — exposed directly, anyone can read anyone's reports.
AUTH_MODE=header

# Optional. The origin the widget is served from. Unset means no CORS headers,
# which is right when the widget and this server share an origin.
# CORS_ORIGIN=https://app.example.com
