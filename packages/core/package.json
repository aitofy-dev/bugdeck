{
    "name": "@aitofy/bugdeck-core",
    "version": "0.1.0",
    "description": "Pure core for bugdeck: the report contract, block parsing, derived titles, image sanitisation and issue rendering.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./contract": {
            "types": "./dist/pure.d.ts",
            "import": "./dist/pure.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test src/__tests__/*.test.ts src/adapters/plane/__tests__/*.test.ts src/adapters/github/__tests__/*.test.ts"
    },
    "optionalDependencies": {
        "sharp": "^0.33.5"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=20"
    },
    "license": "MIT",
    "sideEffects": false,
    "keywords": [
        "marker-io-alternative",
        "bug-reporting",
        "visual-feedback",
        "self-hosted",
        "issue-tracker",
        "plane",
        "plane-so"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitofy-dev/bugdeck.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/aitofy-dev/bugdeck/tree/main/packages/core#readme",
    "bugs": {
        "url": "https://github.com/aitofy-dev/bugdeck/issues"
    },
    "author": "aitofy",
    "publishConfig": {
        "access": "public"
    }
}
